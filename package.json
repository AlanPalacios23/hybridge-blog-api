{
  "name": "hybridge-blog-api",
  "version": "1.0.0",
  "description": "API REST de blog preparada para producción y despliegue en Render.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "jwt",
    "render",
    "rest-api"
  ],
  "author": "Alan Palacios",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/database/**"
    ]
  }
}
